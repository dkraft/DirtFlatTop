/**
 * bmp585_monitor.ino
 *
 * Gravity BMP585 (SEN0664) on Heltec WiFi LoRa 32 V3 (ESP32-S3).
 *
 * Wiring:
 *   BMP585  ->  Heltec V3
 *   D/T (SDA) -> GPIO 19
 *   C/R (SCL) -> GPIO 20
 *   GND     -> GND
 *   VCC     -> 3V3
 *   INT     -> GPIO 47
 *
 * DIP switches on the sensor: I2C mode, address 0x47 (default).
 * Power-cycle the sensor after changing DIP switches.
 *
 * Display:
 *   Live / 1 s / 10 s averages of pressure (hPa) and temperature (F).
 *   Interrupt-driven reads (INT -> GPIO 47).
 */

#include <Wire.h>
#include "HT_SSD1306Wire.h"
#include "DFRobot_BMP58X.h"

/* ---------------- pins ---------------- */
#define BMP_SDA      19
#define BMP_SCL      20
#define BMP_INT      47
#define BMP_ADDR     0x47

/* ---------------- I2C bus for the sensor ---------------- */
TwoWire bmpWire(1);

DFRobot_BMP58X_I2C bmp(&bmpWire, BMP_ADDR);

/* ---------------- OLED ---------------- */
static SSD1306Wire display(0x3c, 500000, SDA_OLED, SCL_OLED, GEOMETRY_128_64, RST_OLED);

/* ---------------- ring buffers for averaging ---------------- */
#define WIN_1S       10      // samples in the 1-second window (25 Hz -> 1 s)
#define WIN_10S      100     // samples in the 10-second window

struct Window {
  float pArr[WIN_10S];
  float tArr[WIN_10S];
  uint16_t head;
  uint16_t count;
  void push(float pPa, float tC) {
    pArr[head] = pPa;
    tArr[head] = tC;
    head       = (head + 1) % WIN_10S;
    if (count < WIN_10S) count++;
  }
  void mean1s(float &p, float &t) {
    if (count < 1) { p = 0; t = 0; return; }
    uint16_t n = (count < WIN_1S) ? count : WIN_1S;
    float ps = 0, ts = 0;
    for (uint16_t i = 0; i < n; i++) {
      uint16_t idx = (head - 1 - i + WIN_10S) % WIN_10S;
      ps += pArr[idx];
      ts += tArr[idx];
    }
    p = ps / n;
    t = ts / n;
  }
} win;

/* ---------------- interrupt plumbing ---------------- */
volatile bool bmp_irq = false;

void bmpIsr() {
  bmp_irq = true;
}

float livePa = 0.0f, liveC = 0.0f;

/* ---------------- grade model ----------------
 * Reference pressure (Pa) that the 3-second settled reading locks to.
 * Grade = altitude delta from that reference, in signed inches.
 * Positive = higher than reference (cut), negative = lower (fill).
 *
 * Standard-atmosphere (hypsometric) altitude, in meters:
 *   h = (T0 / (g * L)) * (1 - (p / p0)^(Rd * L / g))
 * with T0=288.15 K, g=9.80665, L=0.0065 K/m, Rd=287.058, p0=101325 Pa.
 */
#define PRG_PIN      0        // Heltec V3 boot button; held to re-zero
#define SETTLE_MS    3000

static float refPa = 101325.0f;

/* forward decls: the Arduino preprocessor lifts prototypes above these */
static float dispInches = 0.0f;
static unsigned long lastSmoothMs = 0;

/* 0.5s integration window: average the last 500 ms of readings before smoothing.
 * At 25 Hz that's ~13 samples. */
#define INTEG_WINDOW 13
static float integBuf[INTEG_WINDOW];
static uint16_t integHead = 0;
static uint16_t integCount = 0;

static void integPush(float v) {
  integBuf[integHead] = v;
  integHead = (integHead + 1) % INTEG_WINDOW;
  if (integCount < INTEG_WINDOW) integCount++;
}

static float integMean() {
  if (integCount == 0) return 0.0f;
  float s = 0.0f;
  for (uint16_t i = 0; i < integCount; i++) s += integBuf[i];
  return s / integCount;
}

/* ---------------- on-the-fly config (API-style) ----------------
 * These knobs can be updated at runtime by the main unit.
 * The defaults match the current hardcoded values. */
struct GradeConfig {
  float deadzoneIn;    // inches; show 0 below this magnitude
  float arrowEps;      // inches; arrow appears above this (hysteresis)
  float tauRiseMs;     // smoother time-constant, rising edge
  float tauFallMs;     // smoother time-constant, falling edge
} gcfg = { 0.5f, 0.3f, 50.0f, 200.0f };

/* Apply a deadzone: return 0.0f inside the band, else the raw value. */
static float applyDeadzone(float inches) {
  if (fabsf(inches) < gcfg.deadzoneIn) return 0.0f;
  return inches;
}

static float altMeters(float pPa) {
  const float T0 = 288.15f, g = 9.80665f, L = 0.0065f, Rd = 287.058f, p0 = 101325.0f;
  float x = pPa / p0;
  if (x <= 0.0f) x = 0.001f;
  return (T0 / (g * L)) * (1.0f - powf(x, (Rd * L) / g));
}

static float inchesDelta(float pPa) {
  float dm = altMeters(pPa) - altMeters(refPa);   // meters, signed
  return dm * 39.3701f * 6.0f;                     // meters -> inches, 6:1 scale
}

static void lockZero(float pPa) {
  refPa = pPa;
  // Re-zero must snap the displayed value to flat instantly, no glide.
  dispInches = 0.0f;
  lastSmoothMs = millis();
  Serial.printf("zero locked at %.1f Pa\n", refPa);
}

/* ---------------- display smoothing ----------------
 * Asymmetric one-pole smoother (a "ratchet") on the displayed inches.
 * - RISE  (target above display): fast   -> a real grade step shows now
 * - FALL  (target below display): slow   -> tiny wiggles do not jump the number
 * The coefficient is sampled at the 25 Hz sensor rate, so per-tick
 *   alpha = 1 - exp(-dt/tau)
 * with tau_rise = 0.02 s (~63% in 20 ms) and tau_fall = 0.12 s (~63% in 120 ms).
 * This keeps lag low on the direction the operator cares about and kills the
 * jittery back-and-forth without adding a big moving window.
 */
static float smoothInches(float target) {
  unsigned long now = millis();
  unsigned long dt = (lastSmoothMs == 0) ? 40 : (now - lastSmoothMs);
  lastSmoothMs = now;
  if (dt == 0) dt = 4;

  float tau = (target >= dispInches) ? gcfg.tauRiseMs : gcfg.tauFallMs;
  float alpha = 1.0f - expf(-(float)dt / tau);
  dispInches += alpha * (target - dispInches);
  return dispInches;
}

/* ---------------- PRG (calibrate) ----------------
 * GPIO0 is the boot button: reading it LOW means it is being held.
 * To arm a re-zero the pin must be HIGH (released) first, then go LOW
 * and stay LOW ~600 ms. Requiring the prior release means a stuck-LOW
 * pin (pull-down or a held boot button) cannot trap this loop forever.
 * A watchdog also bails out after a few seconds.
 */
static void prgCalibrate() {
  pinMode(PRG_PIN, INPUT_PULLUP);
  unsigned long holdStart = 0;
  unsigned long enterMs   = millis();
  bool arming = false;
  while (true) {
    if (millis() - enterMs > 8000) return;   // watchdog: never trap the UI

    bool held = (digitalRead(PRG_PIN) == LOW);
    if (held) {
      if (!arming) { arming = true; holdStart = millis(); }
      else if (millis() - holdStart >= 600) {
        float p = bmp.readPressPa();
        lockZero(p);
        return;
      }
    } else {
      arming = false;
      // require a clean release before a new press can arm
      holdStart = 0;
    }
    delay(10);
  }
}

/* ---------------- helpers ---------------- */
static float cToF(float c) { return c * 9.0f / 5.0f + 32.0f; }

void vextOn() {
  pinMode(Vext, OUTPUT);
  digitalWrite(Vext, LOW);
  delay(100);
}

/* Draw a solid filled triangle (arrow head). 'up' picks the direction.
 * (cx, cy) is the centroid; halfW is the base half-width, h the height. */
static void drawArrow(int cx, int cy, bool up, int halfW, int h) {
  if (up) {
    int apexY = cy - (h / 2);
    int baseY = cy + (h / 2);
    // left and right edges as vertical line sweeps
    for (int y = apexY; y < baseY; y++) {
      float t = (float)(y - apexY) / (float)h;      // 0 at tip -> 1 at base
      int hw = (int)(t * halfW + 0.5f);
      display.fillRect(cx - hw, y, hw * 2 + 1, 1);
    }
  } else {
    int apexY = cy + (h / 2);
    int baseY = cy - (h / 2);
    for (int y = baseY; y < apexY; y++) {
      float t = 1.0f - (float)(y - baseY) / (float)h; // 0 at base -> 1 at tip
      int hw = (int)(t * halfW + 0.5f);
      display.fillRect(cx - hw, y, hw * 2 + 1, 1);
    }
  }
}

/* Render a grade value: a fat up/down arrow + magnitude in inches.
 * A flat (near-zero) reading shows a horizontal bar instead of an arrow. */
static void drawGrade(const int x, const int y, const int w, const int h, float inches) {
  const float eps = 0.05f;   // treat sub-half-inch as flat
  bool flat = (inches >= -eps) && (inches <= eps);

  if (flat) {
    // center a bar in the arrow box
    int barW = (int)(w * 0.6f + 0.5f);
    int barH = max(2, h / 4);
    display.fillRect(x + (w - barW) / 2, y + (h - barH) / 2, barW, barH);
  } else {
    drawArrow(x + w / 2, y + h / 2, inches > 0.0f, w / 3, h);
  }
}

/* Draw a single digit (0-9) as a large filled block.
 * 5 cols x 6px = 30px wide, 7 rows x 6px = 42px tall.
 * Three digits + 2 gaps of 3px = 30*3 + 6 = 96px. Leaves 32px for the arrow. */
static void drawBigDigit(int x, int y, int digit) {
  // Simple 5x7 digit patterns, scaled to 30x42
  static const uint8_t digits[10][7] = {
    {0b111, 0b101, 0b101, 0b101, 0b101, 0b101, 0b111}, // 0
    {0b001, 0b011, 0b001, 0b001, 0b001, 0b001, 0b001}, // 1
    {0b111, 0b001, 0b001, 0b111, 0b100, 0b100, 0b111}, // 2
    {0b111, 0b001, 0b001, 0b111, 0b001, 0b001, 0b111}, // 3
    {0b101, 0b101, 0b101, 0b111, 0b001, 0b001, 0b001}, // 4
    {0b111, 0b100, 0b100, 0b111, 0b001, 0b001, 0b111}, // 5
    {0b111, 0b100, 0b100, 0b111, 0b101, 0b101, 0b111}, // 6
    {0b111, 0b001, 0b001, 0b001, 0b001, 0b001, 0b001}, // 7
    {0b111, 0b101, 0b101, 0b111, 0b101, 0b101, 0b111}, // 8
    {0b111, 0b101, 0b101, 0b111, 0b001, 0b001, 0b111}, // 9
  };
  if (digit < 0 || digit > 9) digit = 0;
  int px = 6;  // pixel width (30/5 = 6)
  int py = 6;  // pixel height (42/7 = 6)
  for (int row = 0; row < 7; row++) {
    for (int col = 0; col < 5; col++) {
      if (digits[digit][row] & (1 << (4 - col))) {
        display.fillRect(x + col * px, y + row * py, px, py);
      }
    }
  }
}

void drawFrame(float pPa_live) {
  display.clear();

  // Apply the deadzone: the displayed magnitude is 0 inside the band.
  float shown = applyDeadzone(dispInches);
  float mag   = fabsf(shown);

  // ---- layout (128px wide, 64px tall) ----
  // Digits: 3 x 30px + 2 x 3px gaps = 96px, starting at x=2
  // Arrow:  24px wide, at x=101
  // 180-degree rotation mirrors this, so arrow ends up on the left visually.
  int dy = 10;   // top of digits (42px tall -> ends at 52)
  int digitW = 30;
  int gap = 3;
  int dx0 = 2;

  // ---- inches magnitude, always 3 zero-padded digits, 3px between digits ----
  // 3 digits + 2 gaps = 3*30 + 2*3 = 96px, filling the digit zone x=2..98
  // so the group never drifts into the arrow zone (x=101..125).
  int val = (int)lroundf(mag);
  if (val > 999) val = 999;
  char num[4];
  snprintf(num, sizeof(num), "%03d", val);
  int nx = dx0;
  for (int i = 0; i < 3; i++) {
    drawBigDigit(nx + i * (digitW + gap), dy, num[i] - '0');
  }

  // quote mark after the digits (digit zone ends at x=2+96=98)
  display.setFont(ArialMT_Plain_10);
  display.setTextAlignment(TEXT_ALIGN_LEFT);
  display.drawString(99, dy, "\"");

  // ---- arrow or flat bar ----
  int ax = 101;  // arrow x (24px wide -> ends at 125)
  bool showArrow = (mag >= gcfg.arrowEps);
  if (showArrow) {
    drawArrow(ax + 12, 32, dispInches > 0.0f, 10, 52);
  } else {
    display.fillRect(ax, 30, 24, 4);
  }

  // ---- temp underneath the number ----
  char buf[8];
  display.setFont(ArialMT_Plain_10);
  snprintf(buf, sizeof(buf), "%.0fF", cToF(liveC));
  display.drawString(2, 54, buf);

  display.display();
}

/* ---------------- setup ---------------- */
void setup() {
  Serial.begin(115200);
  delay(200);

  vextOn();
  display.init();
  display.screenRotate(ANGLE_180_DEGREE);   // rotate the whole UI 180 degrees
  display.display();

  bmpWire.begin(BMP_SDA, BMP_SCL);

  while (!bmp.begin()) {
    display.clear();
    display.setFont(ArialMT_Plain_10);
    display.drawString(0, 24, "BMP585 init fail");
    display.display();
    Serial.println("Sensor init fail, retrying...");
    delay(1000);
  }
  Serial.println("BMP585 init OK");

  bmp.configInterrupt(bmp.eIntModePulsed, bmp.eIntHighActive, bmp.eIntPushPull);
  bmp.setIntSource(bmp.eIntDataReady);

  pinMode(BMP_INT, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(BMP_INT), bmpIsr, RISING);

  bmp.setODR(bmp.eOdr25Hz);
  bmp.setMeasureMode(bmp.eNormal);

  /* Settle 3 s, then lock the settled reading as the 0" reference. */
  display.clear();
  display.setFont(ArialMT_Plain_10);
  display.setTextAlignment(TEXT_ALIGN_CENTER);
  display.drawString(64, 28, "settle...");
  display.display();
  Serial.printf("settling %d ms\n", SETTLE_MS);

  unsigned long t0 = millis();
  while (millis() - t0 < SETTLE_MS) {
    while (bmp_irq) {
      bmp_irq = false;
      if (bmp.getIntStatus() & bmp.eIntDataReady) {
        float p = bmp.readPressPa();
        win.push(p, bmp.readTempC());
        livePa = p;
      }
    }
    delay(10);
  }

  /* Use the 1s mean of the settled window as the zero baseline. */
  float p1, t1;
  win.mean1s(p1, t1);
  lockZero(p1);

  /* If PRG is held, let the operator re-zero before going live. */
  if (digitalRead(PRG_PIN) == LOW) prgCalibrate();

  drawFrame(livePa);
  Serial.println("ready, PRG holds to re-zero");
}

/* ---------------- loop ---------------- */
void loop() {
  while (bmp_irq) {
    bmp_irq = false;
    if (bmp.getIntStatus() & bmp.eIntDataReady) {
      float pPa = bmp.readPressPa();
      float tC  = bmp.readTempC();
      win.push(pPa, tC);
      livePa = pPa;
      liveC  = tC;
      /* Push into the 0.5s integration window. */
      integPush(inchesDelta(pPa));
    }
  }

  /* Hold PRG to re-zero to 0". */
  if (digitalRead(PRG_PIN) == LOW) prgCalibrate();

  /* Smooth the integrated value (0.5s mean) — not the raw reading. */
  smoothInches(integMean());

  drawFrame(livePa);
}
